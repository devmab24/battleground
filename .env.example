# Copy this file to .env and fill in what you have. Never commit .env.
# Every key is optional: the app runs for free without them.

# Claude API key (the fight judge), from https://platform.claude.com/settings/keys
# Empty: fights use a built-in mock verdict, no cost.
# Set: the real judge runs. Test it with: npm run check:judge
ANTHROPIC_API_KEY=

# Pollinations image key, a SECRET key starting with sk_, from https://enter.pollinations.ai/keys
# Empty: fighters get placeholder art.
POLLINATIONS_API_KEY=

# Upstash Redis for rate limiting, from https://console.upstash.com
# Empty: an in-memory limiter is used. Fine locally, NOT reliable on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
